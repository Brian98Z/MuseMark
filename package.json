{
  "name": "musemark",
  "version": "1.0.0",
  "description": "本地 Markdown 桌面编辑器与媒体预览器（系统 WebView）",
  "private": true,
  "author": "Brian98Z (https://github.com/Brian98Z)",
  "license": "MIT",
  "homepage": "https://github.com/Brian98Z/MuseMark",
  "repository": { "type": "git", "url": "https://github.com/Brian98Z/MuseMark.git" },
  "scripts": {
    "start": "node scripts/build-desktop.cjs dev",
    "dist:win": "node scripts/build-desktop.cjs build --bundles nsis",
    "dist:win:arm64": "node scripts/build-desktop.cjs build --target aarch64-pc-windows-msvc --bundles nsis",
    "dist:mac:x64": "node scripts/build-desktop.cjs build --target x86_64-apple-darwin --bundles dmg",
    "dist:mac:arm64": "node scripts/build-desktop.cjs build --target aarch64-apple-darwin --bundles dmg",
    "dist:linux:x64": "node scripts/build-desktop.cjs build --target x86_64-unknown-linux-gnu --bundles deb,appimage",
    "dist:linux:arm64": "node scripts/build-desktop.cjs build --target aarch64-unknown-linux-gnu --bundles deb,appimage"
  },
  "devDependencies": { "@tauri-apps/cli": "2.12.3" }
}
